# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.

# ---- Server ----
PORT=5000
# Comma-separated list of allowed frontend origins for CORS (credentials enabled).
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 (or the proxy hop count) when running behind a reverse proxy so rate
# limiting sees the real client IP. Leave unset for local dev.
#TRUST_PROXY=1
# NODE_ENV=production makes cookies Secure and turns dev-only fallbacks off.
#NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/white_labeled_portfolio

# ---- Auth ----
# Long random string. Also used to derive OTP/TOTP encryption keys, so rotating
# it invalidates pending OTPs, TOTP secrets and issued tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Access-token lifetime. The refresh cookie/session is what keeps you logged in.
JWT_EXPIRES_IN=7d

# ---- Redis (pending registrations, OTP challenges, refresh sessions) ----
# `npm run dev` runs `docker start wlp-redis` first (Redis 7 on 6380).
REDIS_URL=redis://localhost:6380

# ---- SMTP (OTP verification + password-reset emails) ----
# Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
# If unset in development, OTP codes are logged to the console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Folionce <you@example.com>

# ---- AWS S3 (image / resume uploads) ----
# If these are unset, the upload API returns 503 and the dashboard shows
# "uploads not configured" — everything else still works with placeholders.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-bucket-name
# Custom S3 endpoint for local dev (LocalStack/MinIO). Leave unset for real AWS.
#S3_ENDPOINT=http://localhost:4566
# Base for the public object URLs saved in portfolios. Must match where the
# browser can actually fetch uploads. Leave unset for real AWS
# (defaults to https://<bucket>.s3.<region>.amazonaws.com).
#S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---- Razorpay (subscription billing — pay to publish) ----
# Dashboard > Settings > API Keys. Use test keys (rzp_test_...) in dev.
# If unset, billing endpoints return 503 and publishing is blocked (402).
RAZORPAY_KEY_ID=rzp_test_TCHHahD2NaFzD6
RAZORPAY_KEY_SECRET=aR7SvdX7GHxM1GI4hZuePdgl
# Create a recurring Plan (Dashboard > Subscriptions > Plans) and paste its id.
RAZORPAY_PLAN_ID=plan_TCHAscfHStJMeS
# Dashboard > Settings > Webhooks: set a secret and subscribe to subscription.* events.
RAZORPAY_WEBHOOK_SECRET=https://x5wz7gjn-5000.inc1.devtunnels.ms/api/billing/webhook
# Number of billing cycles before the subscription auto-completes (default 120).
#RAZORPAY_TOTAL_CYCLES=120

# ---- Rate limiting (all optional; values shown are the built-in defaults) ----
# Windows are in minutes; MAX is requests allowed per window.
# Safety net across the whole /api surface, per IP.
RATE_LIMIT_GENERAL_WINDOW_MIN=15
RATE_LIMIT_GENERAL_MAX=300
# Failed login attempts, per IP + email (successful logins don't count).
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_LOGIN_MAX=10
# OTP verification attempts, per IP + email.
RATE_LIMIT_OTP_WINDOW_MIN=15
RATE_LIMIT_OTP_MAX=6
# Email-sending endpoints (register, resend-otp, forgot-password), per IP + email.
RATE_LIMIT_EMAIL_WINDOW_MIN=10
RATE_LIMIT_EMAIL_MAX=3
